// ForzaHaptics settings. The file is reloaded automatically after saving,
// so values can be adjusted while playing. Gain = effect strength (0 disables it).
{
  // UDP port; enter the same value in FH6: Settings → HUD and Gameplay → Data Out IP Port
  "ConfigVersion": 4,
  "Port": 5310,
  // Forward packets to other applications, e.g. ["127.0.0.1:5300"] (only one application can listen on a UDP port)
  "ForwardTo": [],

  // auto | usb | bt   (auto: try USB audio first, then Bluetooth)
  "Output": "auto",
  "UsbLatencyMs": 20,
  // Zero-based haptic channels on the DualSense USB audio device: third and fourth
  "UsbHapticChannels": [ 2, 3 ],

  "MasterGain": 1.0,
  "SwapLeftRight": false,
  // Output frequency band. DualSense actuators are voice coils: below ~60 Hz they are barely
  // perceptible, strongest around ~100–250 Hz (check with the --test frequency sweep), and whine above 350 Hz
  "LowCutHz": 45,
  "HighCutHz": 350,

  // Output compressor: raises quiet textures without letting impacts clip abruptly.
  // Makeup is the overall gain after compression (adjust it or MasterGain for stronger/weaker feedback).
  "Dynamics": {
    "Enabled": true,
    "Threshold": 0.25,
    "Ratio": 3,
    "Makeup": 3.0,
    "AttackMs": 3,
    "ReleaseMs": 150
  },

  // Road texture: the game's SurfaceRumble plus base roughness, increasing with speed
  "Road": {
    "Enabled": true,
    "Gain": 0.55,
    "AsphaltBase": 0.12,
    "SurfaceScale": 1.5,
    "MinFreqHz": 70,
    "MaxFreqHz": 190,
    "FullSpeedKmh": 160
  },

  // Rumble strips: rhythm = speed / spacing, with CarrierHz as the carrier
  "RumbleStrip": {
    "Enabled": true,
    "Gain": 0.5,
    "SpacingMeters": 0.45,
    "MinFreqHz": 12,
    "MaxFreqHz": 110,
    "CarrierHz": 160
  },

  // Suspension impacts (potholes, joints, landings): based on suspension travel speed in m/s
  "Suspension": {
    "Enabled": true,
    "Gain": 0.8,
    "ThresholdMps": 0.3,
    "FullMps": 2.5,
    "FreqHz": 85,
    "DecayMs": 70
  },

  // Loss of grip (TireCombinedSlip > 1)
  "Slip": {
    "Enabled": true,
    "Gain": 0.45,
    "Start": 0.9,
    "Full": 2.5,
    "FreqHz": 120
  },

  // Wheelspin under throttle (TireSlipRatio)
  "Wheelspin": {
    "Enabled": true,
    "Gain": 0.3,
    "Start": 1.0,
    "Full": 3.0,
    "FreqHz": 150
  },

  // Inferred longitudinal braking slip; pulse pattern does not report actual ABS activation
  "Lockup": {
    "Enabled": true,
    "Gain": 0.5,
    "Start": 0.9,
    "Full": 1.5,
    "PulseHz": 14,
    "CarrierHz": 150
  },

  // Engine: frequency follows RPM; kept quiet so it does not overpower road feedback
  "Engine": {
    "Enabled": true,
    "Gain": 0.1,
    "MinFreqHz": 55,
    "MaxFreqHz": 190,
    "LimiterThreshold": 0.97,
    "LimiterGain": 0.2,
    "LimiterHz": 15
  },

  "GearShift": {
    "Enabled": true,
    "Gain": 0.55,
    "FreqHz": 110,
    "DecayMs": 45
  },

  // Collisions: horizontal acceleration (g) + SmashableVelDiff
  "Impact": {
    "Enabled": true,
    "Gain": 1.0,
    "StartG": 3.5,
    "FullG": 15,
    "FreqHz": 75,
    "NoiseFreqHz": 170,
    "SmashFreqHz": 90,
    "DecayMs": 140,
    "SmashableFullVel": 10
  },

  // Puddles: viscous noise plus a splash on entry
  "Water": {
    "Enabled": true,
    "Gain": 0.35,
    "SplashGain": 0.6,
    "FreqHz": 75,
    "SplashFreqHz": 140
  },

  // Event vibration only: gear shifts, wheelspin and lateral/braking slip. No baseline resistance.
  // Amplitudes are normalized command levels, not a certified hardware lifetime limit.
  "Triggers": {
    "Enabled": true,
    "Strength": 0.65,
    "Hysteresis": { "Enabled": true, "SlipBand": 0.2, "PedalBand": 20, "LevelDeadband": 0.35, "VibDeadband": 3, "HoldMs": 150 },
    "Throttle": {
      "Enabled": true, "SlipEnabled": true, "LateralSlipEnabled": true,
      "Intensity": 0.7,
      "GripLoss": 0.9, "VibFreqMin": 30, "MaxVibration": 45, "VibSmoothing": 1.0,
      "VibAmpMin": 0.35, "VibAmpMax": 0.5, "VibAttackMs": 80, "VibReleaseMs": 80,
      "SlipMode": "Continuous", "PulseDurationMs": 250, "PulsePauseMs": 250
    },
    "Brake": {
      "Enabled": true, "SlipEnabled": true,
      "Intensity": 0.7,
      "GripLoss": 0.9, "MinVibration": 25, "MaxVibration": 35, "VibSmoothing": 0.8,
      "VibAmpMin": 0.35, "AbsAmpMax": 0.5, "VibAttackMs": 80, "VibReleaseMs": 80,
      "SlipMode": "Continuous", "PulseDurationMs": 250, "PulsePauseMs": 250
    },
    "GearShift": {
      "ThrottleUpshift": true, "ThrottleDownshift": true, "BrakeUpshift": false, "BrakeDownshift": true,
      "Freq": 20, "Amp": 1.0, "DurationMs": 300, "AttackMs": 50, "ReleaseMs": 50
    },
    "Surface": { "Throttle": false, "Brake": false, "Freq": 10, "Amp": 0.125, "StripFreq": 25, "StripAmp": 0.25 },
    "Collision": { "Enabled": false, "ThresholdMps": 3, "Freq": 40, "Amp": 0.25, "DurationMs": 150 }
  }
}
