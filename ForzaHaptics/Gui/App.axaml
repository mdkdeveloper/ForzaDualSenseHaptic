<Application x:Class="ForzaHaptics.Gui.App"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             RequestedThemeVariant="Dark">
    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Dark" Accent="#4C8DFF" />
            </FluentTheme.Palettes>
        </FluentTheme>
        <StyleInclude Source="avares://ForzaHaptics/Gui/Theme.axaml" />
    </Application.Styles>
</Application>
