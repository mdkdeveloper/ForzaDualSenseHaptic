<Window x:Class="ForzaHaptics.Gui.Dialogs.InputDialog"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="380" SizeToContent="Height" CanResize="False"
        Background="{StaticResource AppSurfaceBrush}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="18" Spacing="12">
        <TextBlock x:Name="PromptText" TextWrapping="Wrap" />
        <TextBox x:Name="ValueBox" MinWidth="300" KeyDown="OnValueKeyDown" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="OK" MinWidth="80" Classes="primaryAction" Click="OnAccept" />
            <Button Content="Cancel" MinWidth="80" Click="OnCancel" />
        </StackPanel>
    </StackPanel>
</Window>
