<Window x:Class="ForzaHaptics.Gui.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ForzaHaptics.Gui.ViewModels"
        xmlns:views="using:ForzaHaptics.Gui.Views"
        xmlns:controls="using:ForzaHaptics.Gui.Controls"
        Title="{Binding Title}"
        Icon="avares://ForzaHaptics/Assets/app.ico"
        Width="1120" Height="820" MinWidth="760" MinHeight="560"
        Background="{StaticResource AppBackgroundBrush}"
        WindowStartupLocation="CenterScreen">
    <Window.Styles>
        <Style Selector="Border.statusBadge">
            <Setter Property="Background" Value="{StaticResource AppInputBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="10,4" />
        </Style>
        <Style Selector="Border.statusBadge.running">
            <Setter Property="Background" Value="#1D3529" />
            <Setter Property="BorderBrush" Value="{StaticResource AppSuccessBrush}" />
        </Style>
        <Style Selector="Border.statusBadge.busy">
            <Setter Property="Background" Value="#3B321F" />
            <Setter Property="BorderBrush" Value="{StaticResource AppWarningBrush}" />
        </Style>
        <Style Selector="Expander.activityLog">
            <Setter Property="Background" Value="{StaticResource AppLogBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Styles>
    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
    </Window.KeyBindings>

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <Border x:Name="ControllerPanel" Grid.Row="0" Background="{StaticResource AppSurfaceBrush}"
                BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="18,10">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                <Path Grid.Column="0" Width="40" Height="28" Stretch="Uniform" Margin="0,0,12,0"
                      VerticalAlignment="Center" Fill="{StaticResource AppTextPrimaryBrush}"
                      AutomationProperties.Name="Game controller"
                      Data="M 14,2 C 9,2 6,5 4,12 L 0,28 C -1,34 3,37 7,33 L 15,25 L 33,25 L 41,33 C 45,37 49,34 48,28 L 44,12 C 42,5 39,2 34,2 L 14,2 Z M 11,10 L 15,10 L 15,14 L 19,14 L 19,18 L 15,18 L 15,22 L 11,22 L 11,18 L 7,18 L 7,14 L 11,14 Z M 33,10 L 37,10 L 37,14 L 33,14 Z M 38,15 L 42,15 L 42,19 L 38,19 Z M 28,15 L 32,15 L 32,19 L 28,19 Z M 33,20 L 37,20 L 37,24 L 33,24 Z" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{Binding ControllerName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="6" Height="6" Fill="{StaticResource AppSuccessBrush}"
                                 VerticalAlignment="Center" IsVisible="{Binding IsControllerConnected}" />
                        <TextBlock Text="{Binding ControllerStatusText}" Classes="secondary" FontSize="12" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0" Spacing="6"
                            IsVisible="{Binding IsBluetoothConnected}" ToolTip.Tip="Connected through Bluetooth">
                    <Path Width="14" Height="22" Stretch="Uniform" Stroke="{StaticResource AppAccentBrush}" StrokeThickness="2"
                          Data="M 2,5 L 14,17 L 8,23 L 8,1 L 14,7 L 2,19" AutomationProperties.Name="Bluetooth" />
                    <TextBlock Text="Bluetooth" VerticalAlignment="Center" Classes="secondary" FontSize="12" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0" Spacing="6"
                            IsVisible="{Binding IsUsbConnected}" ToolTip.Tip="Connected through USB">
                    <Path Width="18" Height="24" Stretch="Uniform" Stroke="{StaticResource AppAccentBrush}" StrokeThickness="1.8"
                          Data="M 10,23 L 10,2 M 6,6 L 10,2 L 14,6 M 10,19 L 3,14 L 3,8 M 10,15 L 17,10 L 17,7 M 15,4 L 19,4 L 19,7 L 15,7 Z M 1,5 L 5,5 L 5,8 L 1,8 Z"
                          AutomationProperties.Name="USB" />
                    <TextBlock Text="USB" VerticalAlignment="Center" Classes="secondary" FontSize="12" />
                </StackPanel>
                <Grid Grid.Column="3" Width="64" Height="48" Margin="0,0,12,0" ToolTip.Tip="{Binding BatteryTooltip}"
                      AutomationProperties.Name="{Binding BatteryTooltip}">
                    <controls:BatteryRing x:Name="ControllerBattery" Width="48" Height="48" HorizontalAlignment="Left"
                                          Percentage="{Binding BatteryPercent}" />
                    <TextBlock Text="{Binding BatteryText}" Width="48" HorizontalAlignment="Left" TextAlignment="Center"
                               VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" />
                    <Path Width="10" Height="17" HorizontalAlignment="Right" VerticalAlignment="Center" Stretch="Uniform"
                          IsVisible="{Binding IsControllerCharging}" Fill="{StaticResource AppWarningBrush}"
                          Data="M 6,0 L 0,9 L 4,9 L 2,16 L 10,6 L 6,6 Z" AutomationProperties.Name="Charging" />
                </Grid>
                <Button x:Name="DisconnectControllerButton" Grid.Column="4" Width="38" Height="38" Padding="9"
                        VerticalAlignment="Center" Command="{Binding DisconnectControllerCommand}"
                        IsEnabled="{Binding CanDisconnectController}" ToolTip.Tip="{Binding DisconnectTooltip}" ToolTip.ShowOnDisabled="True"
                        AutomationProperties.Name="Turn off controller">
                    <Path Width="18" Height="20" Stretch="Uniform" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="2"
                          Data="M 10,1 L 10,11 M 5,5 C -3,10 1,21 10,21 C 19,21 23,10 15,5" />
                </Button>
            </Grid>
        </Border>
        <Border Grid.Row="1" Background="{StaticResource AppSurfaceBrush}"
                BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="14,10">
            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,220,*,Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Profile" VerticalAlignment="Center"
                           Margin="0,0,10,0" FontWeight="SemiBold" />
                <ComboBox x:Name="ProfileSelector" Grid.Row="0" Grid.Column="1"
                          ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                          ToolTip.Tip="Choose the active settings profile" />
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Unsaved changes" IsVisible="{Binding IsDirty}"
                           VerticalAlignment="Center" HorizontalAlignment="Right" Margin="12,0"
                           Foreground="{StaticResource AppWarningBrush}" FontWeight="SemiBold" />
                <Button x:Name="RevertButton" Grid.Row="0" Grid.Column="3" Content="Revert" Margin="0,0,8,0"
                        Command="{Binding RevertCommand}" IsEnabled="{Binding IsDirty}"
                        ToolTip.Tip="Restore the saved profile values" />
                <Button x:Name="SaveButton" Grid.Row="0" Grid.Column="4" Content="Save" MinWidth="84"
                        Command="{Binding SaveCommand}" IsEnabled="{Binding IsDirty}" Classes="primaryAction"
                        ToolTip.Tip="Write changes to the profile file (Ctrl+S)" />

                <WrapPanel Grid.Row="1" Grid.ColumnSpan="5" Orientation="Horizontal" Margin="0,9,0,0">
                    <TextBlock Text="Profile actions" VerticalAlignment="Center" Margin="0,0,12,0" Classes="secondary" />
                    <Button Content="⟳ Refresh" Margin="0,0,6,0" Command="{Binding RefreshProfilesCommand}"
                            ToolTip.Tip="Rescan the Configs folder for profile files" />
                    <Button Content="New" Margin="0,0,6,0" Command="{Binding NewProfileCommand}"
                            ToolTip.Tip="Create a profile with default settings" />
                    <Button Content="Duplicate" Margin="0,0,6,0" Command="{Binding DuplicateProfileCommand}"
                            ToolTip.Tip="Copy the current profile" />
                    <Button Content="Rename" Margin="0,0,6,0" Command="{Binding RenameProfileCommand}" />
                    <Button Content="Delete" Margin="0,0,6,0" Command="{Binding DeleteProfileCommand}"
                            IsEnabled="{Binding CanDeleteProfile}" ToolTip.Tip="Move the profile file to the Recycle Bin" />
                    <TextBlock Text="Default is read-only. Duplicate it to customize." IsVisible="{Binding Settings.IsReadOnly}"
                               VerticalAlignment="Center" Margin="6,0,12,0" Classes="secondary" />
                    <Button Content="Open folder…" Command="{Binding OpenProfilesFolderCommand}"
                            ToolTip.Tip="Open the Configs folder in File Explorer" />
                </WrapPanel>
            </Grid>
        </Border>

        <views:SettingsView Grid.Row="2" DataContext="{Binding Settings}" />

        <Border x:Name="RuntimePanel" Grid.Row="3" Background="{StaticResource AppSurfaceBrush}"
                BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,1,0,0" Padding="14,10">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto">
                <WrapPanel Grid.Row="0" Orientation="Horizontal">
                        <Button x:Name="StartStopButton" Content="{Binding StartStopText}"
                                Command="{Binding StartStopCommand}" IsEnabled="{Binding ControlsEnabled}"
                                MinWidth="88" Margin="0,0,6,0"
                                Classes.primaryAction="{Binding IsEngineStopped}"
                                Classes.destructiveAction="{Binding IsEngineRunning}" />
                        <ToggleButton Content="Simulation" IsChecked="{Binding IsSimulationEnabled, Mode=TwoWay}"
                                      Command="{Binding ApplyModesCommand}" IsEnabled="{Binding ControlsEnabled}"
                                      Margin="0,0,6,0"
                                      ToolTip.Tip="Use a synthetic drive instead of the game to test without FH6" />
                        <ToggleButton Content="Motor test" IsChecked="{Binding IsTestEnabled, Mode=TwoWay}"
                                      Command="{Binding ApplyModesCommand}" IsEnabled="{Binding ControlsEnabled}"
                                      Margin="0,0,6,0"
                                      ToolTip.Tip="Left → right → 20–400 Hz sweep → impulses" />
                        <ToggleButton Content="Gear trigger test" IsChecked="{Binding IsTriggerTestEnabled, Mode=TwoWay}"
                                      Command="{Binding ApplyModesCommand}" IsEnabled="{Binding ControlsEnabled}"
                                      Margin="0,0,6,0"
                                      ToolTip.Tip="Gear shifts only, 12 seconds: hold L2/R2. Upshifts at 2/6/10s; downshifts at 4/8s. Enable the channels and desired gear directions. No slip or body effects. Stop cancels immediately." />
                        <Button Content="{Binding RestartText}" Command="{Binding RestartOutputCommand}"
                                IsEnabled="{Binding ControlsEnabled}" Classes.pending="{Binding RestartPending}"
                                ToolTip.Tip="Apply the port, output, channels, and trigger settings marked with ⟳" />
                </WrapPanel>

                <Grid Grid.Row="1" ColumnDefinitions="Auto,*" Margin="0,8,0,0">
                    <Border Grid.Column="0" Classes="statusBadge" Classes.running="{Binding IsEngineRunning}"
                            Classes.busy="{Binding IsBusy}" VerticalAlignment="Center">
                        <TextBlock Text="{Binding EngineStateText}" FontWeight="SemiBold" />
                    </Border>
                    <TextBlock Grid.Column="1" Text="{Binding StatusText}" VerticalAlignment="Center"
                               Margin="10,0,0,0" TextTrimming="CharacterEllipsis" Classes="secondary" />
                </Grid>

                <Grid Grid.Row="2" Margin="0,8" ColumnDefinitions="Auto,160,Auto,160,*">
                    <TextBlock Grid.Column="0" Text="L signal" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"
                               ToolTip.Tip="Synthesized signal peak, not measured actuator force" />
                    <ProgressBar Grid.Column="1" Value="{Binding LeftMeter}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="R signal" VerticalAlignment="Center" Margin="14,0,8,0" FontWeight="SemiBold"
                               ToolTip.Tip="Synthesized signal peak, not measured actuator force" />
                    <ProgressBar Grid.Column="3" Value="{Binding RightMeter}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="4" Text="{Binding DeviceText}" VerticalAlignment="Center" Margin="14,0,0,0"
                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding DeviceText}" Classes="secondary" />
                </Grid>

                <Expander x:Name="ActivityLogExpander" Grid.Row="3" Header="Activity log"
                          IsExpanded="False" Classes="activityLog" Expanded="OnLogExpanded">
                    <ListBox x:Name="LogList" Height="140" ItemsSource="{Binding LogEntries}"
                             FontFamily="Consolas" FontSize="12" Background="{StaticResource AppLogBrush}"
                             BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:LogEntryViewModel">
                                <TextBlock Text="{Binding Text}" Foreground="{Binding Color}"
                                           TextWrapping="Wrap" Margin="4,2" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Expander>
            </Grid>
        </Border>
    </Grid>
</Window>
