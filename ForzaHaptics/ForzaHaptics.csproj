<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ForzaHaptics</RootNamespace>
    <AssemblyName>ForzaHaptics</AssemblyName>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- Versions are pinned because NAudio 3.x changed IWaveProvider signatures. -->
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="HidSharp" Version="2.1.0" />
    <PackageReference Include="Nefarius.ViGEm.Client" Version="1.21.256" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="HIDMaestro.Core">
      <HintPath>..\third_party\HIDMaestro\HIDMaestro.Core.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Content Include="..\third_party\HIDMaestro\LICENSE" Link="Licenses\HIDMaestro-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\third_party\HIDMaestro\THIRD-PARTY-NOTICES.txt" Link="Licenses\HIDMaestro-THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Using Include="System.IO" />
  </ItemGroup>

  <Target Name="VerifyHidMaestroSdk" BeforeTargets="ResolveAssemblyReferences">
    <GetFileHash Files="$(MSBuildProjectDirectory)\..\third_party\HIDMaestro\HIDMaestro.Core.dll" Algorithm="SHA256">
      <Output TaskParameter="Hash" PropertyName="HidMaestroActualHash" />
    </GetFileHash>
    <Error Condition="'$(HidMaestroActualHash)' != 'D613BE086178D34DEF0C8D3869E801B55CE16D49B7A6E4516281D067AA730D9A'" Text="HIDMaestro SDK checksum mismatch. Restore official v1.9.0 SDK; see third_party/HIDMaestro/README.md." />
  </Target>

  <Target Name="RemoveNativeDependencySymbolsFromPublish" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(ResolvedFileToPublish.AssetType)' == 'native' and '%(ResolvedFileToPublish.Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <!-- Seed is embedded so build/publish never overwrite an edited runtime profile. -->
    <EmbeddedResource Include="Configs/profile_1.json" LogicalName="ForzaHaptics.Configs.profile_1.json" />
    <AvaloniaResource Include="Assets/app.ico" />
  </ItemGroup>

</Project>
